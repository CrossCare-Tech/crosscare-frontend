# Build-time configuration for the CrossCare mobile app.
#
# Every EXPO_PUBLIC_* value is INLINED INTO THE JS BUNDLE at build time. They
# are readable by anyone who inspects a shipped build, so treat all of them as
# public identifiers rather than secrets.
#
# Local development: copy to .env and fill in. Expo CLI loads it automatically.
# EAS builds: .env is NOT uploaded (see .easignore). Register these as EAS
# environment variables instead, e.g. `eas env:push` -- check
# `eas env:push --help` for the flags your CLI version expects.

# --- Required. The app crashes on launch without these. ---

# supabase/supabase.ts builds the client at module scope and app/_layout.tsx
# imports it, so a missing key throws "supabaseKey is required" before the
# first screen renders.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# constants/config.ts exposes this with no fallback, so requests are made to
# "undefined/..." if it is unset.
EXPO_PUBLIC_API_BASE_URL=https://crosscare-backend.onrender.com/api

# --- Required for features, app still starts without them ---

# Doula chatbot. The RAG service is tried first and Gemini is the fallback.
EXPO_PUBLIC_RAG_SERVICE_URL=https://crosscare-rag-75bo.onrender.com/api
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_GEMINI_API=

# Voice input for the chatbot.
EXPO_PUBLIC_DEEPGRAM_API=

# Food/nutrition lookup.
EXPO_PUBLIC_USDA_API_KEY=

# --- Optional ---

# Fitbit supplies steps, heart rate and sleep on Android (iOS uses Apple
# Health instead -- see app/patient/(tabs)/home.tsx). useFitbitStore.ts falls
# back to "" so the app builds and runs without these; Fitbit simply will not
# connect. The OAuth redirect URI must be exactly com.crosscare.tech://auth
# and the Fitbit app type must be Personal for intraday heart rate.
EXPO_PUBLIC_FITBIT_CLIENT_ID=
EXPO_PUBLIC_FITBIT_CLIENT_SECRET=

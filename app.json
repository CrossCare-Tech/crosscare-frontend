{
  "expo": {
    "name": "crosscare",
    "slug": "crosscare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-splash.png",
    "scheme": "com.crosscare.tech",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app requires access to your microphone for voice processing.",
        "NSHealthShareUsageDescription": "This app needs access to read your health data including steps, heart rate, and sleep information to provide personalized health insights."
      },
      "bundleIdentifier": "com.crosscare.tech",
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-splash.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.crosscare.tech",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "package": "com.crosscare.tech"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-splash.png",
          "width": 300,
          "height": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-splash.png",
          "color": "#ffffff"
        }
      ],
      [
      "react-native-health", 
      {
        "healthSharePermission": "Allow Crosscare to access your health data",
        "healthSharePermissionDescription": "This app requires access to your health data to provide personalized insights and recommendations."
      }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b10d128f-00f3-4a0e-baa3-4ffca8140854"
      }
    }
  }
}
